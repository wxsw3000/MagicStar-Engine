; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MagicStar-Engine"
run/main_scene="res://scenes/project_hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene.mobile="res://scenes/main.tscn"

[autoload]

ProjectContext="*res://engine/core/project_context.gd"
EventBus="*res://engine/core/event_bus.gd"
DataManager="*res://engine/core/data_manager.gd"
GameState="*res://engine/core/game_state.gd"
ClueManager="*res://engine/systems/clue_manager.gd"
DialogueManager="*res://engine/systems/dialogue_manager.gd"
ExploreManager="*res://engine/systems/explore_manager.gd"
ReasoningManager="*res://engine/systems/reasoning_manager.gd"
SaveManager="*res://engine/systems/save_manager.gd"
NodeManager="*res://engine/systems/node_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
